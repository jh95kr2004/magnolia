# Stage 1: Build React Frontend SPA
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Build Go API / SSE Node Server
FROM golang:1.25-alpine AS go-builder

WORKDIR /app
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /app/node ./cmd/node

# Stage 3: Unified Runtime Image (SPA + REST/SSE Gateway)
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=go-builder /app/node /app/node
COPY --from=frontend-builder /frontend/dist /app/frontend/dist

ENV STATIC_DIR="/app/frontend/dist"
EXPOSE 8081

CMD ["/app/node"]
