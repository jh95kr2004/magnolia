FROM golang:1.21-alpine AS builder

WORKDIR /app

# Install necessary build tools and protoc for gRPC compilation
RUN apk add --no-cache git make protobuf protobuf-dev

# Install protoc plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.28
RUN go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.2

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Generate gRPC code
RUN protoc --go_out=. --go_opt=paths=source_relative \
    --go-grpc_out=. --go-grpc_opt=paths=source_relative \
    internal/grpc/proto/arbitrage.proto

# Build the node binary
RUN CGO_ENABLED=0 go build -o node cmd/node/main.go

FROM alpine:latest

WORKDIR /root/
COPY --from=builder /app/node .

# Default Master gRPC Address
ENV MASTER_ADDR="master:50051"

EXPOSE 50051

CMD ["./node"]
