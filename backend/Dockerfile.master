FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/go.sum* ./
RUN go mod download

COPY backend/ ./

RUN CGO_ENABLED=0 go build -o /app/engine ./cmd/engine && \
    CGO_ENABLED=0 go build -o /app/feed ./cmd/feed

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/engine /app/engine
COPY --from=builder /app/feed /app/feed

ARG SERVER_VERSION="v2.0.0"
ENV SERVER_VERSION=${SERVER_VERSION}

CMD ["/app/engine"]
